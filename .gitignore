# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]

# ------------------------------------------------------------------ 抓帧素材
# frames/ 与 frames2/ 是录制脚本的滚动输出，单目录 0.6~1.0 GB，
# 且会被不断覆盖，没有任何提交价值（回归用的少量样张另外放在 logs 根目录）。
logs/frames/
logs/frames2/
logs/digits/frames/
logs/digits/crops/
logs/digits/glyphs/

# 截图（调试产物，体积大）
*.png
*.jpg
*.jpeg

# ------------------------------------------------------------------ 运行期产物
*.log
*.lock

# ------------------------------------------------------------------ 本地工具产物
.venv/
*.npz.tmp

# ͷ��ģ����ʶ���ʲ���������⣨����� *.png �ǵ��Խ�ͼ��
!assets/portraits/*.png

# δ��ע��ͷ�������ÿ 10 ��һ�ţ�ֻ�ڱ�עǰ���ã�
assets/portraits/_unknown_*

# ��λ���ݿ������������ݣ����� logs/*.jsonl �ؽ�
logs/roco.db*

# ���ݿⱸ�ݲ����
data/*.bak*

# ����·�����ò����
config/paths.local.json

# ���ӵ�ַ���棨������
board.json

# ------------------------------------------------------------------ 外部资产（roco-cal）
# 识别模型 + S5 精灵/特性数据。是固定资产，必须入库（否则换机器就没了）。
!data/external/roco-cal/models/*.onnx
!data/external/roco-cal/models/*.json
!data/external/roco-cal/models/*.txt
!data/external/roco-cal/pets/*.json
!data/external/roco-cal/traits/**/*.json
!data/external/roco-cal/skills/*.json

# 对面头像模板：之前被 *.png 规则误排除，导致 71 张模板从未入库
!assets/portraits_foe/*.png

# ------------------------------------------------------------------ 外部资产（nrc-ai）
# MIT 许可的效果引擎（技能/特性效果、印记、MCTS）。
# 见 data/external/nrc-ai/VERSION.md
!data/external/nrc-ai/**
!data/external/nrc-ai/data/*.db

# ------------------------------------------------------------------ 外部资产（rocom-helper）
# 只留 data/game 的解包数据（buff/innate/special_move 是我们缺的维度）。
# 上游无 LICENSE，仅作数据参考，不复制代码。
!data/external/rocom-helper/data/game/*.json

# ------------------------------------------------------------------ 外部资产（rocom-data）
# 玩家阵容（169 套）+ 人工战术 YAML。上游无 LICENSE，仅作参考。
# 图片模板（assets/*.png）不入库，体积大且我们用不上。
!data/external/rocom-data/data/**
!data/external/rocom-data/*.py
!data/external/rocom-data/docs/**

# live state (runtime artifact, written every frame by robot)
logs/live_state.json
logs/live_state.json.tmp

# overlay window state (per-machine)
config/overlay.json
config/overlay.json.tmp
